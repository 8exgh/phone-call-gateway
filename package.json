{
  "name": "phone-call-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Twilio phone call gateway with live TTS/STT and prosody-annotated transcripts for LLM orchestration",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "orchestrate": "tsx src/bin/orchestrate.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/websocket": "^11.0.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "openai": "^4.104.0",
    "twilio": "^5.5.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@swc/core": "^1.10.7",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
