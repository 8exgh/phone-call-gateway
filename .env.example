# mock: everything runs offline against in-process fakes (no credentials needed)
# live: real Twilio + OpenAI; requires the credentials below and a public wss URL
MODE=mock
PORT=3300

# live only: Twilio must be able to reach this server over the public internet,
# e.g. an ngrok tunnel: wss://abc123.ngrok.app
PUBLIC_WSS_URL=

# live only: account sid plus EITHER the auth token OR an API key pair
# (API keys are preferred: revocable without rotating the account token)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# optional: use an already-owned number instead of provisioning via POST /numbers
TWILIO_FROM_NUMBER=

# live only (single key covers TTS, transcription, and the orchestration LLM)
OPENAI_API_KEY=

TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# ISO-639-1 language hint for transcription; set empty to auto-detect.
TRANSCRIBE_LANGUAGE=en
# STT endpointing: ms of caller silence before their utterance is considered
# done. Lower = snappier turns, higher = fewer mid-sentence cutoffs.
TRANSCRIBE_SILENCE_MS=450
# Admin password. When set, every client endpoint requires a bearer token:
# this key (admin) or a per-client key minted via POST /clients. Unset = open
# single-tenant mode (dev only).
# ADMIN_API_KEY=change-me
# Durable state (client registry) lives here; mount a volume in production.
DATA_DIR=./data

# Standing policy for ANSWERING incoming calls. Unset = incoming calls are
# rejected. Can be overridden at runtime via POST /inbound-config.
# INBOUND_GOAL=You are the assistant answering this number. Find out who is calling and why, take a message, keep it brief.
# INBOUND_OPENING_LINE=Hi! You have reached Sean's assistant. Who am I speaking with?
CHAT_MODEL=gpt-4o-mini
